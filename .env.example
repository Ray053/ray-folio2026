# MongoDB Atlas connection string
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Random 32+ char secret for Payload (generate: openssl rand -hex 32)
PAYLOAD_SECRET=your-secret-key-min-32-chars

# Vercel Blob storage token (production media). Get it from the Vercel
# dashboard → Storage → your Blob store → ".env" tab. Leave empty locally
# to keep using local disk storage in dev.
BLOB_READ_WRITE_TOKEN=
